    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-ws": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "chess.js": "1.4.0",
    "mongodb": "7.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
